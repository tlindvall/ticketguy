# Copy to a local secret file. Never commit populated values.
# All booleans must be parsed explicitly; the string "false" is not truthy enablement.
NODE_ENV=development
# Public base URL. On Render leave unset: RENDER_EXTERNAL_URL supplies it. Must be https in staging/production.
APP_URL=http://localhost:3000
APP_MODE=fixture
EMAIL_SEND_ENABLED=false
MARKETING_SEND_ENABLED=false
WATCH_SEND_ENABLED=false
HUMAN_REVIEW_REQUIRED=true
EMAIL_TEST_RECIPIENT_ALLOWLIST=

# 'anthropic' (default) or 'rules'. In staging/production 'anthropic' refuses to start without a key;
# 'rules' runs the deterministic extractor as a deliberate choice, never as a silent fallback.
# anthropic | openai | rules. 'rules' runs the deterministic extractor deliberately and needs no key.
EXTRACTION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_MODEL=gpt-5.5
OPENAI_BASE_EFFORT=low
OPENAI_ESCALATION_EFFORT=high
# Rates as model=inputUsdPerMTok:outputUsdPerMTok, comma separated. No OpenAI rates ship with the code —
# without a row here every OpenAI call bills at the conservative default, which exhausts the cap early.
# Verify against your provider's own billing page; aggregator sites go stale. Flat rates are correct for
# this app's usage: extraction truncates input at 12k characters, far below any long-context threshold.
# e.g. MODEL_PRICES_USD_PER_MTOKEN=gpt-5.5=5:30
MODEL_PRICES_USD_PER_MTOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_MODEL=claude-opus-5
# Escalation is the same model at a higher effort level, not a second model.
ANTHROPIC_BASE_EFFORT=low
ANTHROPIC_ESCALATION_EFFORT=high
ANTHROPIC_ESCALATION_ENABLED=false
AI_REQUEST_SOFT_BUDGET_USD=0.50
AI_REQUEST_HARD_BUDGET_USD=1.00
AI_GLOBAL_DAILY_BUDGET_USD=10.00

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# The public address: shown on the site, used as Reply-To on every send, and always accepted inbound.
CONCIERGE_INBOUND_ADDRESS=my@ticketguy.now
# Further addresses the intake accepts, comma separated. Mail to anything else is ignored and audit-logged.
CONCIERGE_INBOUND_ADDRESSES=
CONCIERGE_FROM_ADDRESS=my@ticketguy.now
MARKETING_FROM_ADDRESS=deals@news.ticketguy.now
# Per-message-class From overrides, e.g. watch_alert=alerts@ticketguy.now,verification=hello@ticketguy.now
# Classes: acknowledgment clarification recommendation no_result watch_confirmation watch_alert marketing verification
# Startup fails if an override is not an address the intake accepts, unless it is listed below.
MESSAGE_CLASS_FROM_ADDRESSES=
# From addresses knowingly not receivable. Listing one is an explicit decision to drop replies sent to it.
UNMONITORED_FROM_ADDRESSES=
BUSINESS_POSTAL_ADDRESS=

# Required on Render/staging/production; absent only for local PGlite.
DATABASE_URL=
# Separate privileged migration credential for controlled deploy/CI, never browser/runtime.
MIGRATION_DATABASE_URL=
PG_POOL_MAX=5
PGLITE_DATA_DIR=.local/pglite
MEDIA_PROVIDER=db
MEDIA_MAX_TOTAL_BYTES=1073741824
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
STAFF_EMAIL_ALLOWLIST=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Generate independently; version keys for rotation. Never use these placeholders as secrets.
PREFERENCE_TOKEN_SIGNING_KEY=
INTERNAL_CRON_SECRET=
SENTRY_DSN=

# Discovery is not a live resale quote adapter. Enable only with applicable access/terms cleared.
TICKETMASTER_DISCOVERY_API_KEY=
TICKETMASTER_DISCOVERY_ENABLED=false
LIVE_INVENTORY_ENABLED=false
# Per-provider secrets and permissions added only after a concrete approved adapter is selected.
